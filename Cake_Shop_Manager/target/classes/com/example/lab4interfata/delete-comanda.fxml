<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.DeleteComandaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label contentDisplay="CENTER" text="Introduceti id-ul comenzii pe care doriti sa o stergeti:" textAlignment="CENTER" textFill="#1e00ff" />
        <TextField fx:id="IdComandaTextField" promptText="ID Tort" />
        <Button onAction="#onActionStergeComanda" text="Sterge" />
        <Label fx:id="Mesaj" />
    </children>
</VBox>
