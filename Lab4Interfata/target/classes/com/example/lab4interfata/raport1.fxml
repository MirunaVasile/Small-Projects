<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.Raport1Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label contentDisplay="CENTER" text="Numar de torturi comandate pe zi:" textAlignment="CENTER" textFill="#1e00ff" />

        <!-- TableView to display daily sales -->
        <TableView fx:id="DailySalesTableView" prefHeight="300.0" prefWidth="400.0">
            <!-- Define the columns -->
            <columns>
                <TableColumn fx:id="dateColumn" text="Data" prefWidth="200.0" />
                <TableColumn fx:id="salesColumn" text="Torturi Comandate" prefWidth="200.0" />
            </columns>
        </TableView>

        <Button onAction="#onActionClose" text="Inchide" />
    </children>
</VBox>
