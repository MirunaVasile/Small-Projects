<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.UpdateTortController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Tort" />

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Introduceti id-ul tortului de modificat:" />
            <TextField fx:id="IdTortTextField" promptText="Enter Tort ID" />
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Introduceti noul tip al tortului:" />
            <TextField fx:id="TipTortTextField" promptText="Enter New Tip" />
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <Button text="Update" onAction="#onActionUpdateTort" />
            <Label fx:id="Mesaj" />
        </HBox>

        <Label fx:id="StatusLabel" textFill="red" />
    </children>
</VBox>
