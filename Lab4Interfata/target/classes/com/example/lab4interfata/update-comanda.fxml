<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.UpdateComandaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Comanda" />

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Introduceti id-ul comenzii de modificat:" />
            <TextField fx:id="IdComandaTextField" promptText="Enter Comanda ID" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Data noua:" style="-fx-font-size: 14px;" />
            <DatePicker fx:id="dataDatePicker"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Select Torturi:" style="-fx-font-size: 14px;" />
            <ListView fx:id="tortListView" prefHeight="150" prefWidth="200"/>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <Button text="Update" onAction="#onActionUpdateComanda" />
            <Label fx:id="Mesaj" />
        </HBox>

        <Label fx:id="StatusLabel" textFill="red" />
    </children>
</VBox>
