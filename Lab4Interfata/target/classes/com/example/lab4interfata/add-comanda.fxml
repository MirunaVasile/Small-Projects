<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.AddComandaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label contentDisplay="CENTER" graphicTextGap="5.0" text="Adauga Comanda" textAlignment="CENTER" textFill="#993f93" underline="true" />
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 14px;" text="ID Comanda:" />
            <TextField fx:id="idComandaTextField" promptText="Enter Comanda ID" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 14px;" text="Data:" />
            <DatePicker fx:id="dataDatePicker" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 14px;" text="Select Torturi:" />
            <ListView fx:id="tortListView" prefHeight="150" prefWidth="200" />
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#onActionAdaugaComanda" text="Adauga Comanda" />
            <Button onAction="#onActionAnuleaza" text="Anuleaza" />
        </HBox>
    </children>
</VBox>
