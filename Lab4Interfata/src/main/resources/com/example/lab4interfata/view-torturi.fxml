<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefWidth="458.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab4interfata.ViewTorturiController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label contentDisplay="CENTER" text="Toate torturile noastre:" textAlignment="CENTER" textFill="#1e00ff" />

        <!-- TableView to display cakes -->
        <TableView fx:id="TortTableView" prefHeight="300.0" prefWidth="300.0">
            <!-- Define the columns -->
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="100.0" />
                <TableColumn fx:id="typeColumn" text="Tip" prefWidth="200.0" />
            </columns>
        </TableView>

        <Button onAction="#onActionClose" text="Inchide" />
    </children>
</VBox>
